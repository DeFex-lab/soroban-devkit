  "expected": {
    "totalEvents": 5,
    "finalCursor": "0000000000000005",
    "latestLedger": 1100,
    "pageCount": 3,
    "eventIds": [
      "0000000000000001",
      "0000000000000002",
      "0000000000000003",
      "0000000000000004",
      "0000000000000005"
    ]
  },
  "terminationCases": [
    {
      "name": "no-further-cursor",
      "description": "The loop stops when a page response omits the top-level cursor.",
      "pagesConsumed": 3,
      "expectedEventCount": 5
    },
    {
      "name": "page-cap-reached",
      "description": "The loop stops when the caller-supplied page cap is reached, even if a further cursor is present.",
      "pageCap": 2,
      "expectedEventCount": 4,
      "expectedCursor": "0000000000000004"
    },
    {
      "name": "latest-ledger-passed",
      "description": "The loop stops when the cursor ledger exceeds the reported latestLedger.",
      "latestLedger": 1002,
      "expectedEventCount": 2,
      "expectedCursor": "0000000000000002"
    }
  ],
  "validationCases": [
    {
      "name": "cursor-with-start-ledger",
      "description": "A request carrying cursor together with startLedger must be rejected client-side.",
      "request": {
        "startLedger": 1000,
        "pagination": {
          "cursor": "0000000000000002",
          "limit": 2
        }
      },
      "expectedError": "cursor cannot be combined with startLedger or endLedger"
    },
    {
      "name": "cursor-with-end-ledger",
      "description": "A request carrying cursor together with endLedger must be rejected client-side.",
      "request": {
        "endLedger": 1100,
        "pagination": {
          "cursor": "0000000000000002",
          "limit": 2
        }
      },
      "expectedError": "cursor cannot be combined with startLedger or endLedger"
    }
  ]
}
