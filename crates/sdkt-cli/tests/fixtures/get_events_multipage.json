{
  "description": "Recorded getEvents responses spanning more than one page, used to prove the cursor-following loop accumulates pages and terminates on the documented conditions.",
  "source": {
    "method": "getEvents",
    "network": "soroban-testnet",
    "note": "Responses were captured from a public Soroban testnet RPC using the contract and ledger range recorded below. The event bodies are synthetic but the pagination shape (cursor chaining, page sizes, latestLedger) matches the live RPC."
  },
  "request": {
    "startLedger": 1000,
    "endLedger": 1100,
    "filters": [
